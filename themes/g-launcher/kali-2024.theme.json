{
  "id": "kali-2024",
  "name": "Kali Linux",
  "version": "2024.3",
  "shell": "gnome",
  "tier": "pro",
  "chromeFamily": "generic",
  "palette": {
    "bgTop": "#1B2733",
    "bgBottom": "#0D1117",
    "bar": "#0A0E13",
    "dock": "#CC0A0E13",
    "accent": "#367BF0",
    "onDark": "#FFFFFF"
  },
  "typography": {
