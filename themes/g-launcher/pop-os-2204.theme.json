{
  "id": "pop-os-2204-theme",
  "name": "Pop!_OS",
  "version": "24.04",
  "shell": "gnome",
  "tier": "pro",
  "chromeFamily": "adwaita",
  "palette": {
    "bgTop": "#2B2B2B",
    "bgBottom": "#161616",
    "bar": "#1B1B1B",
    "dock": "#CC1B1B1B",
    "accent": "#48B9C7",
    "onDark": "#FFFFFF"
  },
  "typography": {
    "display": "Fira Sans",
    "mono": "Fira Mono"
  },
  "layout": {
    "dock": "bottom",
    "dockStyle": "floating",
    "topBar": true,
    "panels": [
      {
        "side": "top",
        "modules": [
          "workspacesButton",
          "appsButton",
          "spacer",
          "clock",
          "spacer",
          "tiling",
          "tray"
        ],
        "height": 40
      }
    ],
    "workspaceAxis": "horizontal",
    "desktopIcons": true,
    "grid": {
      "rows": 2,
      "cols": 2
    },
    "iconScale": 1,
    "appDrawer": "query",
    "homeLayout": "tiled",
    "workspaces": 5
  },
  "icons": {
    "treatment": "roundedSquare",
    "cornerRadius": 0.2,
    "foregroundScale": 1,
    "brandPack": "pop-os-2204-line"
  },
  "logo": {
    "light": "logo_light.png",
    "dark": "logo_dark.png"
  },
  "wallpapers": [
    "1.webp",
    "3.webp",
    "2.webp",
    "Wallpapers_1.webp"
  ],
  "wallpaperMeta": {
    "1.webp": {
      "fit": "cover"
    },
    "3.webp": {
      "fit": "cover"
    },
    "2.webp": {
      "fit": "cover"
    },
    "Wallpapers_1.webp": {
      "fit": "cover"
    }
  },
  "boot": {
    "tailMs": 600,
    "lines": [
      {
        "kind": "plain",
        "text": "Loading Linux 6.9.3-76060903-generic ..."
      },
      {
        "kind": "plain",
        "text": "Loading initial ramdisk ..."
      },
      {
        "kind": "blank",
        "text": ""
      },
      {
        "kind": "ok",
        "text": "Started Load Kernel Modules"
      },
      {
        "kind": "ok",
        "text": "Reached target Local File Systems"
      },
      {
        "kind": "ok",
        "text": "Started System76 Power Daemon"
      },
      {
        "kind": "ok",
        "text": "Started System76 Scheduler"
      },
      {
        "kind": "ok",
        "text": "Started NetworkManager"
      },
      {
        "kind": "ok",
        "text": "Started COSMIC Greeter"
      },
      {
        "kind": "ok",
        "text": "Reached target Graphical Interface"
      }
    ]
  },
  "splash": {
    "style": "bar",
    "durationMs": 1200
  },
  "terminal": {
    "appLabel": "COSMIC Terminal",
    "palette": {
      "bg": "#1B1B1B",
      "fg": "#E6E6E6",
      "cursor": "#48B9C7",
      "selection": "#5548B9C7",
      "ansi": [
        "#333333",
        "#CC0000",
        "#4E9A06",
        "#C4A000",
        "#3465A4",
        "#75507B",
        "#06989A",
        "#D3D7CF",
        "#555753",
        "#EF2929",
        "#8AE234",
        "#FCE94F",
        "#729FCF",
        "#AD7FA8",
        "#34E2E2",
        "#EEEEEC"
      ]
    },
    "prompt": "\u001b[1;32m{user}@pop-os\u001b[0m:\u001b[1;34m{cwd}\u001b[0m$ "
  },
  "desklets": {
    "offers": [
      "clock",
      "monitor",
      "network",
      "storage",
      "battery"
    ],
    "starter": [
      {
        "kind": "monitor",
        "page": 1,
        "col": 0,
        "row": 0,
        "spanX": 8,
        "spanY": 4
      }
    ],
    "skins": {
      "clock": {
        "surface": "card",
        "font": "display",
        "accent": true
      },
      "monitor": {
        "surface": "card",
        "font": "display",
        "accent": true
      },
      "network": {
        "surface": "card",
        "font": "display",
        "accent": true
      },
      "storage": {
        "surface": "card",
        "font": "display",
        "accent": true
      },
      "battery": {
        "surface": "card",
        "font": "display",
        "accent": true
      }
    }
  },
  "surfaces": {
    "opacity": 0.94,
    "blur": 8,
    "tint": 0.45,
    "radius": 8
  },
  "minAppVersion": 31,
  "features": [
    {
      "title": "COSMIC's panel",
      "body": "Workspaces and Applications written out on the left, the clock in the middle, and the tiling toggle on the right, the way Pop!_OS 24.04 opens.",
      "exclusive": true
    },
    {
      "title": "Tile with one tap",
      "body": "The panel's tiling toggle switches the desktop between apps filling the screen edge to edge and a plain icon grid.",
      "exclusive": false
    },
    {
      "title": "Search before scrolling",
      "body": "Applications opens on a query, so you type rather than hunt a grid.",
      "exclusive": true
    },
    {
      "title": "A dock that floats",
      "body": "Your apps in a dock along the bottom, with a gap from the edge.",
      "exclusive": false
    },
    {
      "title": "System76 boot",
      "body": "Ten lines through the power daemon and scheduler to the COSMIC Greeter.",
      "exclusive": true
    },
    {
      "title": "Graphite and teal",
      "body": "Rounded icons on near-black, with readouts on accented cards and a COSMIC Terminal in Pop's colours.",
      "exclusive": false
    }
  ]
}
