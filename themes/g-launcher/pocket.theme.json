{
  "id": "pocket-theme",
  "name": "Pocket",
  "version": "2",
  "shell": "aqua",
  "tier": "pro",
  "chromeFamily": "pocket",
  "palette": {
    "bgTop": "#1C1C1E",
    "bgBottom": "#000000",
    "bar": "#1C1C1E",
    "dock": "#3D2C2C2E",
    "accent": "#4C8DFF",
    "onDark": "#FFFFFF"
  },
  "typography": {
    "display": "Inter",
    "mono": "JetBrains Mono"
  },
  "layout": {
    "dock": "bottom",
    "topBar": false,
    "workspaceAxis": "horizontal",
    "appsSurface": "workspace",
    "desktopIcons": true,
    "grid": {
      "rows": 6,
      "cols": 4
    },
    "iconScale": 1,
    "appDrawer": "library",
    "dockStyle": "floating",
    "dockReveal": "desktop",
    "material": "glass",
    "homeSearch": "pill",
    "folderStyle": "glass",
    "dockLauncher": false,
    "dockCapacity": 4,
    "dockSeed": ["dialer", "sms", "browser", "camera"],
    "dockFolders": true,
    "workspaces": 1
  },
  "categories": [
    { "name": "Social", "feeds": ["Social"] },
    { "name": "Entertainment", "feeds": ["Media"] },
    { "name": "Productivity & Finance", "feeds": ["Productivity"] },
    { "name": "Utilities", "feeds": ["Utilities"] },
    { "name": "Travel", "feeds": ["Travel"] },
    { "name": "Games", "feeds": ["Games"] },
    { "name": "Information & Reading", "feeds": ["News"] },
    { "name": "Creativity" },
    { "name": "Shopping & Food" },
    { "name": "Health & Fitness" }
  ],
  "categoryFallback": "Other",
  "icons": {
    "treatment": "squircle",
    "cornerRadius": 0.3,
    "foregroundScale": 1,
    "brandPack": "__none__"
  },
  "iconLooks": [
    { "id": "default", "name": "Default", "icons": {} },
    {
      "id": "dark",
      "name": "Dark",
      "icons": {
        "brandPack": "arcticons-line",
        "brandTreatment": "themePlate",
        "backgroundColor": "#1C1C1E",
        "monochromeTint": "#E5E5EA"
      }
    },
    {
      "id": "clear",
      "name": "Clear",
      "icons": {
        "brandPack": "arcticons-line",
        "brandTreatment": "glass",
        "backgroundColor": "#38FFFFFF",
        "monochromeTint": "#FFFFFF"
      }
    },
    {
      "id": "clearDark",
      "name": "Clear Dark",
      "icons": {
        "brandPack": "arcticons-line",
        "brandTreatment": "glass",
        "backgroundColor": "#59000000",
        "monochromeTint": "#FFFFFF"
      }
    },
    {
      "id": "tinted",
      "name": "Tinted",
      "icons": {
        "brandPack": "arcticons-line",
        "brandTreatment": "themePlate",
        "backgroundColor": "#2A5BD7",
        "monochromeTint": "#F2F2F7"
      }
    }
  ],
  "logo": {
    "light": "logo_light.webp",
    "dark": "logo_dark.webp"
  },
  "wallpapers": [
    "image_2026-08-30_022842834.webp",
    "image_2026-08-30_022909050.webp",
    "image_2026-08-30_022941829.webp",
    "image_2026-08-30_023000224.webp"
  ],
  "minAppVersion": 42,
  "splash": {
    "style": "hello",
    "durationMs": 1200
  },
  "desklets": {
    "offers": ["clock", "battery", "monitor", "network", "storage"],
    "starter": [
      { "kind": "clock", "page": 0, "col": 0, "row": 0, "spanX": 8, "spanY": 6 }
    ],
    "skins": {
      "clock": { "surface": "card", "font": "display", "accent": false, "radius": 22 },
      "monitor": { "surface": "card", "font": "display", "accent": false, "radius": 22 },
      "network": { "surface": "card", "font": "display", "accent": false, "radius": 22 },
      "storage": { "surface": "card", "font": "display", "accent": false, "radius": 22 },
      "battery": { "surface": "card", "font": "display", "accent": false, "radius": 22 }
    }
  },
  "features": [
    {
      "title": "Liquid Glass",
      "body": "The dock, the Search button, folders, widgets and the App Library on one see-through glass, tinted by your wallpaper with a bright edge.",
      "exclusive": true
    },
    {
      "title": "Four icon looks",
      "body": "Hold the home and tap Customize: Default, Dark, Clear, Clear Dark or Tinted, and folders and widgets follow.",
      "exclusive": true
    },
    {
      "title": "Swipe down to search",
      "body": "From anywhere on the home, or tap Search above the dock.",
      "exclusive": true
    },
    {
      "title": "The App Library",
      "body": "Swipe past your last page: Suggestions and Recently Added first, then every app filed by what it is for, on glass tiles.",
      "exclusive": true
    },
    {
      "title": "Folders of nine",
      "body": "Glass folders that show the first nine apps, open as a glass panel of three by three pages, and rename in place.",
      "exclusive": true
    },
    {
      "title": "A widget first",
      "body": "Your home opens on a large clock and date on glass, above a four by six grid.",
      "exclusive": true
    },
    {
      "title": "A phone's dock",
      "body": "Four home-sized icons on glass. Drag to rearrange, drop one app on another to make a folder, and drag apps between the dock and the home.",
      "exclusive": true
    },
    {
      "title": "Hello, Pocket OS",
      "body": "The first boot writes Pocket OS across the screen by hand, then every boot after is the logo and a thin bar.",
      "exclusive": true
    }
  ],
  "gestures": {
    "swipeDown": "search"
  }
}
