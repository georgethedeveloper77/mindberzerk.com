<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Defined by G VPN and granted only to Mindberzerk-signed apps. -->
    <uses-permission android:name="com.mindberzerk.permission.VPN_CONTROL" />

    <!-- Android 11+ hides other apps unless they are named here. -->
    <queries>
        <package android:name="com.mindberzerk.gvpn" />
    </queries>
</manifest>
