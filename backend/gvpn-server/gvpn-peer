#!/usr/bin/env python3
"""Run ON the server, as root: talks to the local agent exactly as the
Firebase backend will, signed with the same secret.

  sudo gvpn-peer add phone     new client keys, a peer, a config and a QR
  sudo gvpn-peer health        what the admin panel will show
  sudo gvpn-peer remove <pubkey>

For testing and support only. In production the PHONE makes its own keys.
"""

import base64
import hashlib
import hmac
import json
import os
import subprocess
import sys
import time
import urllib.request

ENV = "/etc/gvpn-agent.env"


def env() -> dict:
    out = {}
    with open(ENV) as f:
        for line in f:
            if "=" in line and not line.startswith("#"):
                k, v = line.strip().split("=", 1)
                out[k] = v
    return out


def call(method: str, path: str, body: bytes = b"") -> dict:
    e = env()
    ts = str(int(time.time()))
    msg = b"\n".join([method.encode(), path.encode(), ts.encode(), body])
    sig = hmac.new(e["GVPN_AGENT_SECRET"].encode(), msg, hashlib.sha256).hexdigest()
    port = e.get("GVPN_AGENT_PORT", "8443")
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}",
        data=body or None,
        method=method,
        headers={"X-GVPN-Time": ts, "X-GVPN-Sig": sig, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


def add(name: str) -> None:
    private = subprocess.run(["wg", "genkey"], capture_output=True, text=True, check=True).stdout.strip()
    public = subprocess.run(["wg", "pubkey"], input=private, capture_output=True, text=True, check=True).stdout.strip()
    peer = call("POST", "/peers", json.dumps({"publicKey": public}).encode())
    config = "\n".join([
        "[Interface]",
        # G VPN reads "Name" to label the server; the device name is a note.
        f"# Name = {env().get('GVPN_SERVER_NAME', 'G Server')}",
        f"# Device = {name}",
        f"PrivateKey = {private}",
        f"Address = {peer['address']}",
        f"DNS = {peer['dns']}",
        "",
        "[Peer]",
        f"PublicKey = {peer['serverPublicKey']}",
        f"AllowedIPs = {peer['allowedIps']}",
        f"Endpoint = {peer['endpoint']}",
        "PersistentKeepalive = 25",
        "",
    ])
    print(config)
    print(f"Peer public key: {public}\n")
    # Scan this with G VPN, Servers, Scan QR.
    subprocess.run(["qrencode", "-t", "ansiutf8"], input=config, text=True, check=False)


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] not in {"add", "health", "remove"}:
        sys.exit(__doc__)
    if sys.argv[1] == "add":
        add(sys.argv[2] if len(sys.argv) > 2 else "test")
    elif sys.argv[1] == "health":
        print(json.dumps(call("GET", "/health"), indent=2))
    else:
        key = base64.urlsafe_b64encode(base64.b64decode(sys.argv[2])).decode()
        print(call("DELETE", f"/peers/{key}"))


if __name__ == "__main__":
    main()
