          "height": 56
        }
      ]
    }
  },
  {
    "id": "macos",
    "name": "macOS-like",
    "summary": "Top bar, floating dock",
    "layout": {
      "dock": "bottom",
      "topBar": true,
      "panels": [
        {
          "side": "top",
          "modules": [
            "activities",
            "spacer",
            "tray",
            "clock"
          ],
          "height": 36
        }
      ]
    }
  },
  {
    "id": "gnome",
    "name": "GNOME",
