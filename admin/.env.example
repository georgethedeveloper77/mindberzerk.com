# Local development only. NEVER commit the filled-in version.
# In production these come from Secret Manager via apphosting.yaml.

# The ed25519 private half, 64 hex chars, from `node tools/sign-pack.mjs keygen`.
# Same key whose public half is in PackKeys.ACCEPTED_HEX.
PACK_SIGNING_KEY=
PACK_KEY_ID=

# Cloudflare R2, S3-compatible API.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN_VALUE=

# Comma-separated Firebase Auth UIDs. Yours only.
ADMIN_UIDS=

# Firebase client config (public).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Service account for firebase-admin, as a single-line JSON string.
# In production App Hosting supplies application-default credentials and this
# is unnecessary.
# Delete this line entirely
# FIREBASE_SERVICE_ACCOUNT=...

# Use the path instead. applicationDefault() reads this variable natively.
GOOGLE_APPLICATION_CREDENTIALS=
