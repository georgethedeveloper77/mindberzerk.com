{
  "id": "arch-hyprland",
  "name": "Arch + Hyprland",
  "version": "rolling",
  "shell": "tiling",
  "tier": "pro",
  "minAppVersion": 6,
  "palette": {
    "bgTop": "#0F1419",
    "bgBottom": "#0A0E12",
    "bar": "#11151A",
    "dock": "#000000",
    "accent": "#1793D1",
    "onDark": "#E6EDF3"
  },
  "typography": {
    "display": "Ubuntu",
    "mono": "UbuntuMono"
  },
  "layout": {
    "dock": "off",
    "topBar": true,
    "grid": {
      "rows": 5,
      "cols": 4
    }
  },
  "icons": {
    "treatment": "square",
    "cornerRadius": 0.1,
    "foregroundScale": 0.82,
    "backgroundColor": "#11151A"
  },
  "wallpapers": [
    "assets/themes/arch-hyprland/wallpapers/arch_dark.webp"
  ],
  "boot": {
    "tailMs": 700,
    "lines": [
      {
        "kind": "plain",
        "text": ":: running early hook [udev]"
      },
      {
        "kind": "plain",
        "text": ":: running hook [plymouth]"
      },
      {
        "kind": "plain",
        "text": ":: running hook [keymap]"
      },
      {
        "kind": "plain",
        "text": ":: performing fsck on '/dev/nvme0n1p2'"
      },
      {
        "kind": "plain",
        "text": ":: mounting '/dev/nvme0n1p2' on real root"
      },
      {
        "kind": "blank",
        "text": ""
      },
      {
        "kind": "dim",
        "text": "[    0.000000] Linux version 6.9.7-arch1-1"
      },
      {
        "kind": "dim",
        "text": "[    0.284531] systemd[1]: systemd 256 running in system mode"
      },
      {
        "kind": "dim",
        "text": "[    0.512004] systemd[1]: Detected architecture arm64."
      },
      {
        "kind": "ok",
        "text": "Reached target Local Encrypted Volumes"
      },
      {
        "kind": "ok",
        "text": "Started Journal Service"
      },
      {
        "kind": "ok",
        "text": "Reached target System Initialization"
      },
      {
        "kind": "ok",
        "text": "Started D-Bus System Message Bus"
      },
      {
        "kind": "ok",
        "text": "Started NetworkManager"
      },
      {
        "kind": "warn",
        "text": "Starting Hyprland session ...",
        "delayMs": 460
      },
      {
        "kind": "ok",
        "text": "Started Hyprland session"
      },
      {
        "kind": "ok",
        "text": "Reached target Graphical Interface"
      }
    ]
  }
}
