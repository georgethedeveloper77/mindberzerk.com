{
  "id": "kde-plasma-6",
  "name": "KDE Plasma",
  "version": "6",
  "shell": "plasma",
  "tier": "free",
  "chromeFamily": "breeze",
  "palette": {
    "bgTop": "#1B2733",
    "bgBottom": "#151A1F",
    "bar": "#31363B",
    "dock": "#CC2A2E32",
    "accent": "#3DAEE9",
    "onDark": "#FCFCFC"
  },
  "paletteLight": {
    "bgTop": "#BFD4E8",
    "bgBottom": "#E1EAF3",
    "bar": "#CEDDEB",
    "dock": "#C2CEDDEB",
    "accent": "#3DAEE9",
    "onDark": "#232629"
  },
  "typography": {
    "display": "Noto Sans",
    "mono": "Noto Sans Mono"
  },
  "surfaces": {
    "opacity": 0.86,
    "blur": 20,
    "tint": 0.6,
    "radius": 10
  },
  "layout": {
    "dock": "off",
    "panels": [
      {
        "side": "bottom",
        "modules": [
          "kickoff",
          "tasks",
          "spacer",
          "tray",
          "clock"
        ]
      }
    ],
    "desktopIcons": true,
    "panelEdit": true,
    "grid": {
      "rows": 5,
      "cols": 4
    }
  },
  "icons": {
    "treatment": "squircle",
    "cornerRadius": 0.28,
    "foregroundScale": 1,
    "backgroundColor": "#31363B",
    "brandPack": "kde-plasma-6-line"
  },
  "logo": {
    "light": "logo_light.webp",
    "dark": "logo_dark.webp"
  },
  "wallpapers": [
    "1.webp",
    "2.webp",
    "3.webp",
    "4.webp",
    "kde_breeze.webp"
  ],
  "minAppVersion": 6,
  "boot": {
    "tailMs": 600,
    "lines": [
      {
        "kind": "plain",
        "text": "Loading Linux ..."
      },
      {
        "kind": "plain",
        "text": "Loading initial ramdisk ..."
      },
      {
        "kind": "blank",
        "text": ""
      },
      {
        "kind": "ok",
        "text": "Started Load Kernel Modules"
      },
      {
        "kind": "ok",
        "text": "Reached target Local File Systems"
      },
      {
        "kind": "ok",
        "text": "Started udev Kernel Device Manager"
      },
      {
        "kind": "ok",
        "text": "Started D-Bus System Message Bus"
      },
      {
        "kind": "ok",
        "text": "Started NetworkManager"
      },
      {
        "kind": "ok",
        "text": "Started Bluetooth Service"
      },
      {
        "kind": "warn",
        "text": "Starting Simple Desktop Display Manager ...",
        "delayMs": 500
      },
      {
        "kind": "ok",
        "text": "Started Simple Desktop Display Manager"
      },
      {
        "kind": "ok",
        "text": "Reached target Graphical Interface"
      }
    ]
  },
  "splash": {
    "style": "bar",
    "durationMs": 1200
  },
  "desklets": {
    "offers": [
      "clock",
      "monitor",
      "network",
      "storage",
      "battery",
      "free",
      "df",
      "uptime"
    ],
    "starter": [
      {
        "kind": "clock",
        "page": 0,
        "col": 0,
        "row": 0
      },
      {
        "kind": "monitor",
        "page": 0,
        "col": 4,
        "row": 0
      },
      {
        "kind": "df",
        "page": 0,
        "col": 0,
        "row": 2
      }
    ],
    "skins": {
      "clock": {
        "surface": "card",
        "font": "display",
        "accent": true
      },
      "monitor": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "network": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "storage": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "battery": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "free": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "df": {
        "surface": "card",
        "font": "mono",
        "accent": true
      },
      "uptime": {
        "surface": "card",
        "font": "mono",
        "accent": true
      }
    }
  },
  "features": [
    {
      "title": "Panel edit mode",
      "body": "Hold the panel, add or remove modules, move it to any edge.",
      "exclusive": true
    },
    {
      "title": "Desktop icons",
      "body": "Folder View, with apps placed on the workspace itself.",
      "exclusive": true
    },
    {
      "title": "One bottom panel",
      "body": "Kickoff at one end, your most-used apps beside it, tray and clock at the other.",
      "exclusive": true
    },
    {
      "title": "Plasma boot",
      "body": "Twelve lines of SDDM start-up before the desktop appears.",
      "exclusive": true
    },
    {
      "title": "Breeze palette",
      "body": "Noto Sans, squircle icons, and a light set for daytime.",
      "exclusive": false
    }
  ]
}
