<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="accessibility_label">G Launcher gestures</string>

    <!-- Shown verbatim in the system permission screen. Say exactly what it
         does and nothing else; vagueness here is what makes people refuse. -->
    <string name="accessibility_description">Lets G Launcher open the notification shade, quick settings, recents, and lock the screen from a gesture. It does not read your screen and it does not watch other apps.</string>

    <!-- Shown in Android's notification-access list, which is where the user
         grants this. The label is the only text they see beside our checkbox,
         so it names the FEATURE rather than the app: "G Launcher" alone in a
         list of notification listeners tells them nothing about why it wants
         in. -->
    <string name="notification_listener_label">G Launcher notification badges</string>

    <!-- BrokenInstallActivity: this copy is missing its native code (installed
         from a shared APK rather than from Play). Native strings, because the
         Flutter side that owns translations is what cannot start. -->
    <string name="broken_install_title">G Launcher did not install completely</string>
    <string name="broken_install_body">This copy is missing part of the app, which happens when it is installed from a shared file instead of Google Play. Reinstall it from Google Play to fix it.</string>
    <string name="broken_install_reinstall">Reinstall from Google Play</string>
    <string name="broken_install_other_home">Choose another home app</string>
</resources>
