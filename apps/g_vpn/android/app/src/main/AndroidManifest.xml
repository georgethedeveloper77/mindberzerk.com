<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- G VPN's session service: the notification with Pause / Disconnect,
         and the countdown that reconnects after a pause. -->
    <!-- Lets G Launcher and G Recovery read G VPN's status and control it.
         "knownSigner": granted only to apps signed with a certificate in
         res/values/family.xml (Android 12+). Never to anything else. -->
    <permission
        android:name="com.mindberzerk.permission.VPN_CONTROL"
        android:description="@string/gvpn_family_permission_desc"
        android:knownCerts="@array/gvpn_family_certs"
        android:label="@string/gvpn_family_permission_label"
        android:protectionLevel="signature|knownSigner" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      firebase_analytics pulls in AD_ID through play-services-measurement. A
      privacy app has no use for the advertising ID, and declaring it forces an
      advertising-ID answer in Play's Data Safety form. Same call as G Recovery.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Auto-connect: the "tap to protect" fallback, and re-arming the network
         watch after a reboot (PendingIntent callbacks do not survive one). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wi-Fi NAME only. Android ties the SSID to location permission; G VPN
         asks only when the user taps "Show name", after an in-app disclosure,
         and never reads or stores a location. -->
    <!-- Wi-Fi scanner tool: read and trigger scans of nearby networks. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      allowBackup OFF, deliberately. Saved tunnels hold WireGuard PRIVATE KEYS,
      and Android's auto backup would copy them to the user's Google Drive.
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:label="G VPN"
        android:name=".GVpnApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to G VPN": a QR image, or WireGuard settings as text. -->
            <intent-filter android:label="@string/gvpn_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/gvpn_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          WireGuard's own VpnService. The tunnel library declares it too; this
          copy merges with it and keeps the declaration visible here, next to
          the permission that Play's VpnService policy review looks for.
        -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Auto-connect. Not exported: the network callback is a PendingIntent
             we own, and the two system broadcasts are delivered to
             non-exported receivers by the platform. -->
        <receiver
            android:name=".AutoConnectReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Pause, resume and disconnect from the notification. "specialUse"
             is the type Android 14 assigns to VPN session controls; the
             property is the explanation Play reviews. -->
        <service
            android:name=".GvpnSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's VPN session controls (pause countdown, resume, disconnect) in the notification." />
        </service>

        <!-- Quick Settings tile: connect to the last server, or disconnect. -->
        <service
            android:name=".GvpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_gvpn"
            android:label="G VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- G VPN family: status for G Launcher / G Recovery, and their
             connect / disconnect / pause requests. -->
        <provider
            android:name=".GvpnFamilyProvider"
            android:authorities="com.mindberzerk.gvpn.family"
            android:exported="true"
            android:readPermission="com.mindberzerk.permission.VPN_CONTROL"
            android:writePermission="com.mindberzerk.permission.VPN_CONTROL" />

        <activity
            android:name=".GvpnControlActivity"
            android:exported="true"
            android:permission="com.mindberzerk.permission.VPN_CONTROL"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.mindberzerk.gvpn.action.CONNECT" />
                <action android:name="com.mindberzerk.gvpn.action.DISCONNECT" />
                <action android:name="com.mindberzerk.gvpn.action.PAUSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- SSTP engine (Open SSTP Client, MIT): free VPN Gate servers over
             SSTP. Started only by G VPN; Android binds it as the VPN. -->
        <service
            android:name="kittoku.osc.service.SstpVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN connection to the server the user chose." />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Analytics keeps app-level usage only: no ad ID, no ad personalisation. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
            <!-- The OpenVPN engine's notification opens
             "<package>.activities.MainActivity". Route it to G VPN. -->
        <activity-alias
            android:name=".activities.MainActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

    </application>

    <queries>
        <!-- App rules list launchable apps only. This narrow query avoids
             QUERY_ALL_PACKAGES, a restricted permission on Play. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Legal pages and the source code open in a browser tab. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
